<?xml version="1.0" encoding="utf-8"?>
<!-- 隐私要求：题目图片、解答与密钥一律不进入系统云备份与设备迁移。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
