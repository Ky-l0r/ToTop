# ============================================================================
# ToTop 考试失分分析 API —— 环境变量示例
#
# 用法：复制本文件为 `.env`（与 requirements.txt 同级），按需修改。
#   Copy-Item .env.example .env
#
# 说明：
# - 变量名大小写不敏感（pydantic-settings）；
# - 列表型配置可以用逗号分隔（CORS_ORIGINS=http://a.com,http://b.com）或 JSON 数组；
# - 未列出的变量会被忽略（extra="ignore"）。
# - 只有 `ENABLE_MOCK_PAY` 是「本文件独有」的开关（读取自系统环境变量，未进 Settings）。
# ============================================================================

# ----------------------------------------------------------------- 基础
# 服务名（出现在 /docs 标题与日志里）
APP_NAME=ToTop 考试失分分析 API
# 服务版本号（/health 返回）
APP_VERSION=0.1.0
# 运行环境：dev（开发）/ test（测试）/ prod（生产）
# dev 与 test 会开放 /docs，并允许回传短信验证码；prod 一律关闭
ENV=dev
# 调试开关（影响业务日志级别：true=DEBUG，false=INFO）
DEBUG=true
# API 路由前缀
API_V1_PREFIX=/api/v1
# uvicorn 监听地址与端口（用 python -m uvicorn 启动时可被命令行参数覆盖）
HOST=127.0.0.1
PORT=8000
# 对外可访问的站点根地址：用于拼接静态资源 URL 与支付回调地址
# 手机真机调试时改成局域网 IP，例如 http://192.168.1.10:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 允许跨域的来源，`*` 表示全部（生产必须收紧为具体域名）
CORS_ORIGINS=*

# ----------------------------------------------------------------- 数据库
# 本地开发用 SQLite（相对路径会被解析到 services/api 目录下）
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# 生产示例（需先安装 asyncpg）：
# DATABASE_URL=postgresql+asyncpg://totop:password@127.0.0.1:5432/totop
# 打印所有 SQL（排查慢查询时打开，日志量很大）
DB_ECHO=false
# 启动时自动建表（开发方便；生产建议关闭并改用 alembic 迁移）
AUTO_CREATE_TABLES=true

# ----------------------------------------------------------------- 安全
# JWT 签名密钥 —— 生产必须改成随机长字符串，切勿使用默认值
SECRET_KEY=dev-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------- 限流 / Redis / 短信频率
# Redis 用于限流计数与验证码缓存；连不上时自动降级（限流走内存、验证码走数据库）
REDIS_URL=redis://127.0.0.1:6379/0
# 是否启用限流（关闭后 SMS_SEND_INTERVAL_SECONDS 等仍然生效）
RATE_LIMIT_ENABLED=true
# 单 IP 每分钟请求上限（全局兜底，作用于 /api/v1）
RATE_LIMIT_PER_MINUTE=240
# 同一手机号两次发送验证码的最小间隔（秒）
SMS_SEND_INTERVAL_SECONDS=60
# 同一手机号每天最多发送验证码次数
SMS_DAILY_LIMIT_PER_PHONE=10

# ----------------------------------------------------------------- 短信
# dev=只写日志与数据库（不真实发送）；aliyun=预留（尚未实现真实发送）
SMS_PROVIDER=dev
# 验证码有效期（秒）
SMS_CODE_TTL_SECONDS=300
# 开发模式是否在响应体回传 dev_code（生产必须 false）
SMS_DEV_RETURN_CODE=true

# ------------------------------------------------------------- AI Provider
# auto=配置了 DASHSCOPE_API_KEY 就用 qwen，否则用 mock；也可强制 mock / qwen
AI_PROVIDER=auto
# 阿里云百炼 API Key（留空则自动使用 Mock Provider，全链路仍可跑通）
DASHSCOPE_API_KEY=
# 百炼 OpenAI 兼容端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 视觉模型名（试卷手写体识别推荐 qwen-vl-max）
QWEN_MODEL=qwen-vl-max
# 单次模型调用超时（秒）
AI_TIMEOUT_SECONDS=120
# 可重试错误（429/5xx）的最大尝试次数
AI_MAX_RETRIES=3
# 单次分析最多送入模型的图片张数（直接决定 token 成本）
AI_MAX_IMAGES=6
# Mock Provider 的假数据模板（可直接编辑以定制演示效果）
# MOCK_SAMPLE_PATH=app/providers/ai/mock_sample.json

# --------------------------------------------------------------- 对象存储
# local=存到 STORAGE_DIR 并通过 /static 访问；s3=S3/OSS 兼容（需安装 boto3）
STORAGE_BACKEND=local
# 本地存储目录（默认 services/api/storage，一般不用改）
# STORAGE_DIR=storage
# 静态资源 URL 前缀（与 PUBLIC_BASE_URL 拼接成完整地址）
STORAGE_URL_PREFIX=/static
# 单文件上传大小上限（MB）
MAX_UPLOAD_MB=20
# 允许上传的扩展名（逗号分隔）
ALLOWED_UPLOAD_EXT=.jpg,.jpeg,.png,.webp,.heic,.bmp,.pdf,.docx

# S3 / OSS（STORAGE_BACKEND=s3 时必填）
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# 预签名 URL 有效期（秒）
S3_PRESIGN_EXPIRE_SECONDS=900

# --------------------------------------------------------------- 业务规则
# 每次 AI 分析消耗的点数
ANALYSIS_CREDIT_COST=1
# 注册赠送点数
REGISTER_BONUS_CREDITS=1
# 累计观看多少次激励视频兑换一次奖励
AD_WATCH_NEEDED=10
# 每轮兑换的点数
AD_REWARD_CREDITS=1

# ------------------------------------------------- 模拟支付开关（非 Settings 字段）
# 仅开发联调用：POST /orders/{order_no}/pay 会直接把订单标记为已支付并到账
# 不设置时默认：ENV=dev|test 为 true，ENV=prod 为 false
# ENABLE_MOCK_PAY=true
