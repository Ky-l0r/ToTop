# To Top 统一编辑规范
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# Compose 官方约定：@Composable 函数使用 PascalCase（如 ToTopTheme、SolveScreen），
# 与 Kotlin 普通函数的小驼峰规则不同。ktlint 官方为此提供按注解豁免的属性，
# 否则全部 Composable 都会被 standard:function-naming 误报。
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview

[*.{xml,json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
