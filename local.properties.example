# 复制为 local.properties 后按本机实际路径填写。
# local.properties 已在 .gitignore 中排除，禁止提交真实配置。
# Windows 路径中的反斜杠需转义，或统一改用正斜杠。

sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk

# 可选：签名配置（仅 release 构建需要，本地调试可留空）
# RELEASE_STORE_FILE=../keystore/release.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
